    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "8.1.1"
  }
